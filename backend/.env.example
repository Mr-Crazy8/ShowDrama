PORT=3000
NODE_ENV=development

# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT Authorization Secret
JWT_SECRET=your-random-jwt-secret-min-32-chars

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_SUCCESS_URL=https://your-app.com/success
STRIPE_CANCEL_URL=https://your-app.com/cancel

# RevenueCat Integration
REVENUECAT_WEBHOOK_AUTH_HEADER=Bearer_your_revenuecat_auth_token

# Cloudflare R2 Video & Image Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=showdrama
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Redis Connection
REDIS_URL=redis://localhost:6379

# Internal Webhook Security Secret
PIPELINE_INTERNAL_SECRET=shared-secret-between-backend-and-pipeline

# Pipeline Service Host URL
PIPELINE_SERVICE_URL=http://localhost:8000
